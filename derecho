/* =========================================================
   IDIOMA ACTUAL
========================================================= */

let idiomaActual = "es";


/* =========================================================
   CAMBIAR TODO EL IDIOMA
========================================================= */

function cambiarIdioma(idioma) {

    idiomaActual = idioma;

    const textos = traducciones[idioma];

    /*
       AQUÍ ESTÁ LA PARTE IMPORTANTE:

       Busca TODOS los elementos que tengan data-i18n
       y cambia su contenido por la traducción correspondiente.
    */

    document.querySelectorAll("[data-i18n]").forEach(elemento => {

        const clave = elemento.getAttribute("data-i18n");

        if (textos[clave]) {
            elemento.textContent = textos[clave];
        }

    });


    /*
       También cambia el idioma del documento.
       Esto ayuda a los lectores de pantalla y al navegador.
    */

    document.documentElement.lang = idioma;


    /*
       Cambia el título de la pestaña.
    */

    const titulos = {

        es: "Derecho Natural",

        en: "Natural Law",

        ko: "자연법",

        ja: "自然法"

    };

    document.title = titulos[idioma];


    /*
       Cierra el menú de idiomas.
    */

    document
        .getElementById("menuIdiomas")
        .classList.remove("mostrar");


    /*
       Guardamos el idioma para que no se pierda
       al cambiar de pantalla.
    */

    localStorage.setItem("idioma", idioma);
}


/* =========================================================
   ABRIR / CERRAR MENÚ DE IDIOMAS
========================================================= */

function abrirIdiomas() {

    document
        .getElementById("menuIdiomas")
        .classList.toggle("mostrar");
}


/* =========================================================
   CAMBIAR DE PANTALLA
========================================================= */

function irA(id) {

    /*
       Ocultamos todas las pantallas.
    */

    document
        .querySelectorAll(".pantalla")
        .forEach(pantalla => {

            pantalla.classList.remove("activa");

        });


    /*
       Mostramos la pantalla seleccionada.
    */

    const pantalla = document.getElementById(id);

    if (pantalla) {
        pantalla.classList.add("activa");
    }


    /*
       Actualizamos la URL.
       Ejemplo:
       index.html#derecho
       index.html#ejemplos
       etc.
    */

    history.pushState(null, "", "#" + id);


    /*
       Regresamos arriba de la página.
    */

    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });
}


/* =========================================================
   BOTÓN MODO OSCURO / CLARO
========================================================= */

function cambiarTema() {

    document.body.classList.toggle("dark");

    const oscuro =
        document.body.classList.contains("dark");


    const boton = document.getElementById("botonTema");

    if (oscuro) {

        boton.innerHTML =
            '☀️ <span data-i18n="modoClaro"></span>';

    } else {

        boton.innerHTML =
            '🌙 <span data-i18n="modoOscuro"></span>';

    }


    /*
       MUY IMPORTANTE:
       Después de modificar el botón,
       volvemos a traducirlo al idioma actual.
    */

    const textoActual =
        traducciones[idiomaActual];

    boton.querySelector("[data-i18n]").textContent =
        oscuro
        ? textoActual.modoClaro
        : textoActual.modoOscuro;


    /*
       Guardamos la preferencia.
    */

    localStorage.setItem(
        "tema",
        oscuro ? "dark" : "light"
    );
}


/* =========================================================
   CARGAR CONFIGURACIÓN GUARDADA
========================================================= */

function cargarConfiguracion() {

    /*
       Cargar idioma
    */

    const idiomaGuardado =
        localStorage.getItem("idioma");

    if (idiomaGuardado && traducciones[idiomaGuardado]) {

        cambiarIdioma(idiomaGuardado);

    }


    /*
       Cargar tema
    */

    const temaGuardado =
        localStorage.getItem("tema");

    if (temaGuardado === "dark") {

        document.body.classList.add("dark");

        const boton =
            document.getElementById("botonTema");

        boton.innerHTML =
            '☀️ <span data-i18n="modoClaro"></span>';

        const texto =
            traducciones[idiomaActual];

        boton.querySelector("[data-i18n]").textContent =
            texto.modoClaro;
    }


    /*
       Si la URL tiene una pantalla específica,
       la abrimos.
    */

    const hash =
        window.location.hash.replace("#", "");

    if (hash && document.getElementById(hash)) {

        irA(hash);

    }

}


/* =========================================================
   CERRAR MENÚ SI SE HACE CLIC FUERA
========================================================= */

document.addEventListener("click", function(event) {

    const traductor =
        document.querySelector(".traductor");

    const menu =
        document.getElementById("menuIdiomas");

    if (!traductor.contains(event.target)) {

        menu.classList.remove("mostrar");

    }

});


/* =========================================================
   BOTONES ATRÁS / ADELANTE DEL NAVEGADOR
========================================================= */

window.addEventListener("popstate", function() {

    const hash =
        window.location.hash.replace("#", "");

    if (hash && document.getElementById(hash)) {

        document
            .querySelectorAll(".pantalla")
            .forEach(p => p.classList.remove("activa"));

        document
            .getElementById(hash)
            .classList.add("activa");

    } else {

        irA("inicio");

    }

});


/* =========================================================
   INICIAR
========================================================= */

cargarConfiguracion();

</script>

