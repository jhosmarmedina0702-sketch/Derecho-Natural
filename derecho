<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Derecho Natural</title>

<style>
/* =========================================================
   PALETA Y VARIABLES
========================================================= */

:root {
    --fondo: #fff8ff;
    --fondo-secundario: #f5eaff;
    --texto: #342044;
    --texto-suave: #6f5b7d;

    --morado: #9b6cff;
    --morado-oscuro: #7044d8;
    --rosa: #ff8fc7;
    --azul: #70d7ff;
    --amarillo: #ffe58a;
    --verde: #8ee6bd;

    --tarjeta: rgba(255,255,255,0.88);
    --borde: rgba(155,108,255,0.25);

    --sombra: 0 15px 40px rgba(104, 65, 150, 0.16);
}

/* =========================================================
   MODO OSCURO
========================================================= */

body.dark {
    --fondo: #171221;
    --fondo-secundario: #211932;
    --texto: #f8efff;
    --texto-suave: #cfc1dc;

    --tarjeta: rgba(38, 28, 53, 0.94);
    --borde: rgba(190, 150, 255, 0.28);

    --sombra: 0 15px 40px rgba(0,0,0,0.35);
}

/* =========================================================
   GENERAL
========================================================= */

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    min-height: 100vh;
    font-family: "Segoe UI", Arial, sans-serif;
    background:
        radial-gradient(circle at 10% 10%, rgba(255,143,199,0.20), transparent 25%),
        radial-gradient(circle at 90% 20%, rgba(112,215,255,0.20), transparent 25%),
        radial-gradient(circle at 50% 100%, rgba(155,108,255,0.18), transparent 30%),
        var(--fondo);
    color: var(--texto);
    transition: background 0.4s ease, color 0.4s ease;
    overflow-x: hidden;
}

/* =========================================================
   DECORACIONES
========================================================= */

.decoracion {
    position: fixed;
    border-radius: 50%;
    filter: blur(1px);
    opacity: 0.6;
    z-index: -1;
    pointer-events: none;
}

.bola1 {
    width: 180px;
    height: 180px;
    background: var(--rosa);
    top: -70px;
    left: -60px;
}

.bola2 {
    width: 220px;
    height: 220px;
    background: var(--azul);
    right: -90px;
    top: 25%;
}

.bola3 {
    width: 160px;
    height: 160px;
    background: var(--amarillo);
    bottom: -50px;
    left: 20%;
}

/* =========================================================
   CONTENEDOR
========================================================= */

.contenedor {
    width: min(1150px, 92%);
    margin: auto;
}

/* =========================================================
   BARRA SUPERIOR
========================================================= */

.barra {
    position: sticky;
    top: 0;
    z-index: 1000;

    backdrop-filter: blur(15px);
    background: rgba(255,255,255,0.55);
    border-bottom: 1px solid var(--borde);

    padding: 15px 0;
}

body.dark .barra {
    background: rgba(23,18,33,0.75);
}

.barra-contenido {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 12px;
}

/* =========================================================
   BOTONES SUPERIORES
========================================================= */

.boton-control {
    border: none;
    background: var(--tarjeta);
    color: var(--texto);

    border: 1px solid var(--borde);
    border-radius: 30px;

    padding: 11px 18px;
    font-size: 14px;
    font-weight: 700;

    cursor: pointer;

    box-shadow: 0 5px 15px rgba(100,70,140,0.10);

    transition: all 0.25s ease;
}

.boton-control:hover {
    transform: translateY(-2px);
    background: var(--morado);
    color: white;
}

/* =========================================================
   TRADUCTOR
========================================================= */

.traductor {
    position: relative;
}

.menu-idiomas {
    position: absolute;
    right: 0;
    top: 52px;

    width: 180px;

    background: var(--tarjeta);
    border: 1px solid var(--borde);
    border-radius: 18px;

    padding: 8px;

    box-shadow: var(--sombra);

    display: none;
}

.menu-idiomas.mostrar {
    display: block;
}

.menu-idiomas button {
    width: 100%;
    border: none;
    background: transparent;

    color: var(--texto);

    padding: 11px;
    border-radius: 12px;

    cursor: pointer;
    font-size: 14px;
    text-align: left;

    transition: 0.2s;
}

.menu-idiomas button:hover {
    background: var(--fondo-secundario);
}

/* =========================================================
   PANTALLAS
========================================================= */

.pantalla {
    display: none;
    min-height: calc(100vh - 75px);

    padding: 70px 0 90px;

    animation: aparecer 0.45s ease;
}

.pantalla.activa {
    display: block;
}

@keyframes aparecer {
    from {
        opacity: 0;
        transform: translateY(15px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* =========================================================
   PORTADA
========================================================= */

.portada {
    text-align: center;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    min-height: calc(100vh - 75px);
}

.icono-principal {
    width: 95px;
    height: 95px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 30px;

    background: linear-gradient(
        135deg,
        var(--morado),
        var(--rosa)
    );

    color: white;

    font-size: 45px;

    box-shadow: var(--sombra);

    margin-bottom: 30px;

    transform: rotate(-4deg);
}

h1 {
    font-size: clamp(2.4rem, 6vw, 4.8rem);
    line-height: 1.05;

    margin-bottom: 20px;

    background: linear-gradient(
        90deg,
        var(--morado-oscuro),
        var(--rosa)
    );

    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.subtitulo {
    max-width: 700px;

    margin: 0 auto 50px;

    color: var(--texto-suave);

    font-size: 1.15rem;
    line-height: 1.8;
}

/* =========================================================
   MENÚ PRINCIPAL
========================================================= */

.titulo-menu {
    text-align: center;

    font-size: 1.8rem;

    margin-bottom: 28px;
}

.menu-principal {
    width: min(850px, 100%);
    margin: auto;

    display: grid;

    grid-template-columns: repeat(2, 1fr);

    gap: 22px;
}

.opcion-menu {
    border: none;

    min-height: 125px;

    border-radius: 28px;

    padding: 25px;

    background: var(--tarjeta);

    border: 1px solid var(--borde);

    color: var(--texto);

    text-align: left;

    cursor: pointer;

    box-shadow: var(--sombra);

    transition: 0.3s ease;

    display: flex;
    align-items: center;
    gap: 18px;
}

.opcion-menu:hover {
    transform: translateY(-6px) scale(1.01);
    border-color: var(--morado);
}

.numero {
    min-width: 50px;
    height: 50px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 17px;

    background: linear-gradient(
        135deg,
        var(--morado),
        var(--rosa)
    );

    color: white;

    font-weight: bold;
    font-size: 20px;
}

.opcion-menu strong {
    display: block;
    font-size: 17px;
    line-height: 1.4;
}

/* =========================================================
   PÁGINAS DE INFORMACIÓN
========================================================= */

.encabezado-pagina {
    text-align: center;
    margin-bottom: 55px;
}

.encabezado-pagina .icono {
    font-size: 45px;
    margin-bottom: 18px;
}

.encabezado-pagina h2 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: 15px;
}

.encabezado-pagina p {
    color: var(--texto-suave);
    font-size: 1.1rem;
}

/* =========================================================
   TARJETAS DE INFORMACIÓN
========================================================= */

.informacion {
    display: grid;
    grid-template-columns: repeat(2, 1fr);

    gap: 25px;
}

.tarjeta {
    background: var(--tarjeta);

    border: 1px solid var(--borde);

    border-radius: 28px;

    padding: 32px;

    box-shadow: var(--sombra);

    transition: 0.25s ease;
}

.tarjeta:hover {
    transform: translateY(-4px);
}

.tarjeta.grande {
    grid-column: 1 / -1;
}

.tarjeta h3 {
    color: var(--morado-oscuro);

    margin-bottom: 15px;

    font-size: 1.35rem;
}

body.dark .tarjeta h3 {
    color: #c7a9ff;
}

.tarjeta p {
    color: var(--texto-suave);

    line-height: 1.85;

    font-size: 1rem;
}

.tarjeta ul {
    padding-left: 22px;
}

.tarjeta li {
    color: var(--texto-suave);
    margin-bottom: 12px;
    line-height: 1.7;
}

/* =========================================================
   EJEMPLOS
========================================================= */

.ejemplos {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 22px;
}

.ejemplo {
    padding: 30px;

    background: var(--tarjeta);

    border: 1px solid var(--borde);

    border-radius: 26px;

    box-shadow: var(--sombra);

    text-align: center;
}

.ejemplo-icono {
    font-size: 38px;
    margin-bottom: 18px;
}

.ejemplo h3 {
    margin-bottom: 12px;
    color: var(--morado-oscuro);
}

body.dark .ejemplo h3 {
    color: #c7a9ff;
}

.ejemplo p {
    color: var(--texto-suave);
    line-height: 1.7;
}

/* =========================================================
   NAVEGACIÓN
========================================================= */

.navegacion {
    display: flex;

    justify-content: center;
    align-items: center;

    gap: 15px;

    margin-top: 55px;

    flex-wrap: wrap;
}

.boton-nav {
    border: none;

    padding: 14px 24px;

    border-radius: 30px;

    background: var(--morado);

    color: white;

    font-weight: bold;

    cursor: pointer;

    transition: 0.25s;
}

.boton-nav:hover {
    background: var(--morado-oscuro);
    transform: translateY(-2px);
}

.boton-secundario {
    background: var(--tarjeta);

    color: var(--texto);

    border: 1px solid var(--borde);
}

/* =========================================================
   WHATSAPP
========================================================= */

.contacto {
    margin-top: 55px;

    text-align: center;

    padding: 35px;

    border-radius: 30px;

    background:
        linear-gradient(
            135deg,
            rgba(142,230,189,0.28),
            rgba(112,215,255,0.22)
        );

    border: 1px solid var(--borde);
}

.contacto h3 {
    margin-bottom: 12px;
}

.contacto p {
    color: var(--texto-suave);
    margin-bottom: 22px;
}

.whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 10px;

    padding: 14px 25px;

    background: #25D366;

    color: white;

    text-decoration: none;

    border-radius: 30px;

    font-weight: bold;

    transition: 0.25s;
}

.whatsapp:hover {
    transform: translateY(-3px);
}

/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 800px) {

    .menu-principal {
        grid-template-columns: 1fr;
    }

    .informacion {
        grid-template-columns: 1fr;
    }

    .tarjeta.grande {
        grid-column: auto;
    }

    .ejemplos {
        grid-template-columns: 1fr;
    }

    .barra-contenido {
        justify-content: center;
    }

    .pantalla {
        padding-top: 45px;
    }
}

@media (max-width: 500px) {

    .boton-control {
        padding: 9px 13px;
        font-size: 13px;
    }

    .tarjeta {
        padding: 24px;
    }

    .opcion-menu {
        min-height: 110px;
        padding: 20px;
    }
}
/* =========================================================
   UNIVERSO DECORATIVO ANIMADO
   NO MODIFICA EL MODO OSCURO NI LAS TRADUCCIONES
========================================================= */

.espacio-decorativo {
    position: fixed;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: -1;
}

/* =========================================================
   PLANETAS
========================================================= */

.planeta {
    position: absolute;
    border-radius: 50%;
    box-shadow:
        inset -15px -15px 25px rgba(0,0,0,0.16),
        0 10px 30px rgba(100,70,160,0.18);

    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
}

/* Planeta morado */

.planeta-1 {
    width: 72px;
    height: 72px;

    top: 15%;
    left: 5%;

    background:
        radial-gradient(
            circle at 30% 25%,
            #d8bfff,
            #9b6cff 50%,
            #7044d8
        );

    animation:
        planetaFlota1 5s ease-in-out infinite;
}

/* Anillo */

.planeta-1 .anillo {
    position: absolute;

    width: 105px;
    height: 30px;

    border: 5px solid rgba(255,143,199,0.75);

    border-radius: 50%;

    top: 22px;
    left: -17px;

    transform: rotate(-18deg);
}

/* Planeta rosa */

.planeta-2 {
    width: 48px;
    height: 48px;

    top: 34%;
    right: 6%;

    background:
        radial-gradient(
            circle at 30% 25%,
            #ffd1e8,
            #ff8fc7 55%,
            #e765a5
        );

    animation:
        planetaFlota2 6s ease-in-out infinite;
}

/* Planeta amarillo */

.planeta-3 {
    width: 62px;
    height: 62px;

    bottom: 18%;
    left: 7%;

    background:
        radial-gradient(
            circle at 30% 25%,
            #fff6bc,
            #ffe58a 55%,
            #e5bf4f
        );

    animation:
        planetaFlota3 7s ease-in-out infinite;
}

/* Cráteres */

.crater {
    position: absolute;

    border-radius: 50%;

    background: rgba(190,150,55,0.22);

    box-shadow:
        inset 2px 2px 4px rgba(120,90,20,0.15);
}

.crater-1 {
    width: 12px;
    height: 12px;

    top: 14px;
    left: 17px;
}

.crater-2 {
    width: 8px;
    height: 8px;

    top: 34px;
    left: 38px;
}

.crater-3 {
    width: 6px;
    height: 6px;

    top: 27px;
    left: 11px;
}

/* Planeta azul */

.planeta-4 {
    width: 38px;
    height: 38px;

    bottom: 12%;
    right: 9%;

    background:
        radial-gradient(
            circle at 30% 25%,
            #c9f4ff,
            #70d7ff 55%,
            #38a9d3
        );

    animation:
        planetaFlota4 5.5s ease-in-out infinite;
}


/* =========================================================
   ANIMACIONES DE LOS PLANETAS
========================================================= */

@keyframes planetaFlota1 {

    0%, 100% {
        transform:
            translateY(0)
            rotate(-8deg);
    }

    50% {
        transform:
            translateY(-22px)
            rotate(8deg);
    }
}


@keyframes planetaFlota2 {

    0%, 100% {
        transform:
            translate(0, 0)
            rotate(0deg);
    }

    50% {
        transform:
            translate(-16px, -25px)
            rotate(12deg);
    }
}


@keyframes planetaFlota3 {

    0%, 100% {
        transform:
            translateY(0)
            rotate(0deg);
    }

    50% {
        transform:
            translateY(-18px)
            rotate(-12deg);
    }
}


@keyframes planetaFlota4 {

    0%, 100% {
        transform:
            translate(0, 0);
    }

    50% {
        transform:
            translate(15px, -20px);
    }
}


/* =========================================================
   ESTRELLAS
========================================================= */

.estrella {
    position: absolute;

    color: var(--morado);

    font-size: 24px;

    opacity: 0.75;

    animation:
        estrellaBrilla 2.5s ease-in-out infinite;
}

.estrella-1 {
    top: 12%;
    left: 24%;
    animation-delay: 0s;
}

.estrella-2 {
    top: 25%;
    right: 24%;
    animation-delay: 0.7s;
}

.estrella-3 {
    bottom: 28%;
    left: 23%;
    animation-delay: 1.2s;
}

.estrella-4 {
    bottom: 15%;
    right: 27%;
    animation-delay: 0.4s;
}

.estrella-5 {
    top: 52%;
    left: 4%;
    animation-delay: 1.7s;
}

.estrella-6 {
    top: 67%;
    right: 5%;
    animation-delay: 2s;
}


@keyframes estrellaBrilla {

    0%, 100% {
        opacity: 0.25;
        transform: scale(0.75) rotate(0deg);
    }

    50% {
        opacity: 1;
        transform: scale(1.3) rotate(20deg);
    }
}


/* =========================================================
   PEQUEÑOS PUNTOS FLOTANTES
========================================================= */

.punto {
    position: absolute;

    width: 7px;
    height: 7px;

    border-radius: 50%;

    background: var(--rosa);

    opacity: 0.65;

    animation:
        puntoFlota 4s ease-in-out infinite;
}

.punto-1 {
    top: 20%;
    left: 42%;
}

.punto-2 {
    top: 42%;
    right: 32%;
    animation-delay: 1s;
}

.punto-3 {
    bottom: 35%;
    left: 40%;
    animation-delay: 1.8s;
}

.punto-4 {
    bottom: 20%;
    right: 42%;
    animation-delay: 0.5s;
}

.punto-5 {
    top: 70%;
    left: 15%;
    animation-delay: 2.2s;
}


@keyframes puntoFlota {

    0%, 100% {
        transform:
            translateY(0)
            scale(0.8);

        opacity: 0.35;
    }

    50% {
        transform:
            translateY(-15px)
            scale(1.2);

        opacity: 0.9;
    }
}


/* =========================================================
   EN MÓVIL: HACER LOS PLANETAS MÁS DISCRETOS
========================================================= */

@media (max-width: 700px) {

    .planeta-1 {
        width: 48px;
        height: 48px;
        left: -8px;
    }

    .planeta-1 .anillo {
        width: 70px;
        height: 20px;
        top: 14px;
        left: -11px;
        border-width: 3px;
    }

    .planeta-2 {
        width: 35px;
        height: 35px;
        right: 4px;
    }

    .planeta-3 {
        width: 42px;
        height: 42px;
        left: 3px;
    }

    .planeta-4 {
        width: 30px;
        height: 30px;
        right: 4px;
    }

    .estrella {
        font-size: 18px;
    }
}
</style>
</head>

<body>
<!-- =====================================================
     DECORACIONES ANIMADAS
===================================================== -->

<div class="espacio-decorativo">

    <!-- PLANETAS -->
    <div class="planeta planeta-1">
        <div class="anillo"></div>
    </div>

    <div class="planeta planeta-2"></div>

    <div class="planeta planeta-3">
        <div class="crater crater-1"></div>
        <div class="crater crater-2"></div>
        <div class="crater crater-3"></div>
    </div>

    <div class="planeta planeta-4"></div>

    <!-- ESTRELLAS -->
    <span class="estrella estrella-1">✦</span>
    <span class="estrella estrella-2">✧</span>
    <span class="estrella estrella-3">✦</span>
    <span class="estrella estrella-4">✧</span>
    <span class="estrella estrella-5">✦</span>
    <span class="estrella estrella-6">✧</span>

    <!-- ESTRELLITAS PEQUEÑAS -->
    <span class="punto punto-1"></span>
    <span class="punto punto-2"></span>
    <span class="punto punto-3"></span>
    <span class="punto punto-4"></span>
    <span class="punto punto-5"></span>

</div>
<!-- =====================================================
     DECORACIONES
===================================================== -->

<div class="decoracion bola1"></div>
<div class="decoracion bola2"></div>
<div class="decoracion bola3"></div>

<!-- =====================================================
     BARRA SUPERIOR
===================================================== -->

<header class="barra">
    <div class="contenedor barra-contenido">

        <div class="traductor">

            <button
                class="boton-control"
                id="botonTraductor"
                onclick="abrirIdiomas()">
