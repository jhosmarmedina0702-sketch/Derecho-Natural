                <button onclick="cambiarIdioma('ko')">
                    🇰🇷 한국어
                </button>

                <button onclick="cambiarIdioma('ja')">
                    🇯🇵 日本語
                </button>

            </div>

        </div>

        <button
            class="boton-control"
            id="botonTema"
            onclick="cambiarTema()">
            🌙 <span data-i18n="modoOscuro">Modo oscuro</span>
        </button>

    </div>
</header>


<!-- =====================================================
     PANTALLA 0
===================================================== -->

<section id="inicio" class="pantalla activa">

    <div class="contenedor portada">

        <div class="icono-principal">
            ⚖️
        </div>

        <h1 data-i18n="bienvenida">
